# A SparkPost API key with the "Transmissions: Read/Write" permission.
SPARKPOST_API_KEY=

# Where the test message goes.
SPARKPOST_TO=you@example.com

# Who it comes from. This must be a verified sending domain on the account - or leave it
# on sparkpostbox.com, SparkPost's sandbox domain, which needs no verification but is
# limited to a handful of messages and requires the sandbox option (send.php sets it).
SPARKPOST_FROM=test@sparkpostbox.com

# Optional. The envelope FROM - where bounces are delivered, and the domain SPF is
# checked against. Leave it empty and SparkPost uses the account's own bounce domain.
#
# This is NOT validated when the transmission is posted, and SPARKPOST_FROM is - which is
# the distinction worth keeping straight. Verified 22 August 2026: a From on a domain that
# is not a configured sending domain is rejected outright, while a completely bogus return
# path was accepted, 200. The two are checked in different places, by different rules.
#
# The cost of a bogus one turns up later instead. That message never arrived - blocked
# somewhere downstream, DMARC being the likely reason, since the envelope domain is what
# SPF authenticates. So a 200 here means the payload was well formed and nothing more.
#
# For DMARC to pass on the strength of SPF, the domain also has to align with the header
# From in SPARKPOST_FROM - so bounces@example.com against a From of noreply@example.com
# aligns, and the same address against a From on another domain authenticates but does
# not align.
SPARKPOST_RETURN_PATH=

# Optional. Set to eu for the EU tenancy.
SPARKPOST_REGION=
