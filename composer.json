{
    "name": "hampel/sparkpost",
    "description": "A PHP client for the SparkPost API - transmissions, message events and suppression - over any PSR-18 HTTP client",
    "authors": [
        {
            "name": "Simon Hampel",
            "email": "simon@hampelgroup.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/hampel/sparkpost/issues",
        "source": "https://github.com/hampel/sparkpost"
    },
    "keywords": [
        "sparkpost",
        "email",
        "api",
        "psr-18"
    ],
    "homepage": "https://github.com/hampel/sparkpost",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1|^2.0",
        "psr/log": "^1.1|^2.0|^3.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.8",
        "hampel/rig": "^0.1.2",
        "laravel/pint": "^1.30",
        "phpstan/phpstan": "^2.1.22",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Hampel\\SparkPost\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hampel\\SparkPost\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "format": "pint",
        "lint": "pint --test",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    }
}
